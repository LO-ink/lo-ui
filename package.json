{
  "name": "lo-ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run build -w @lo-ink/design-tokens && npm run build -w @lo-ink/ui && npm run dev -w @lo/ui-gallery",
    "test": "npm run build && vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check .",
    "ci": "make ci",
    "test:packages": "node scripts/test-packages.mjs",
    "lint": "eslint . --max-warnings 0",
    "architecture": "depcruise --config .dependency-cruiser.cjs packages/*/src apps/*/src",
    "format": "prettier --write .",
    "security": "npm audit --audit-level=high",
    "test:coverage": "npm run build && vitest run --coverage",
    "policy": "node scripts/check-policy.mjs",
    "secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "globals": "16.5.0",
    "dependency-cruiser": "17.4.3",
    "@vitest/coverage-v8": "5.0.3",
    "@types/node": "24.13.3"
  }
}
