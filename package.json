{
  "name": "lo-ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run build -w @lo/design-tokens && npm run build -w @lo/ui && npm run dev -w @lo/ui-gallery",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm test && npm run format:check && npm run test:packages",
    "test:packages": "node scripts/test-packages.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
